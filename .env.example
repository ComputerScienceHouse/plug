# Used by the Computer Science House "csh_auth" library
# For more info, see https://github.com/liam-middlebrook/csh-auth
# https://wiki.csh.rit.edu/wiki/SSO
CSH_AUTH_CLIENT_ID=
CSH_AUTH_CLIENT_SECRET=
CSH_AUTH_STATE=
CSH_AUTH_JWT_SECRET=
CSH_AUTH_SERVER_HOST=sso.csh.rit.edu
CSH_AUTH_REDIRECT_URI=http://localhost:8080/auth/redir

# S3 Bucket credentials. Ask an RTP for credentials or
# spin one up yourself using DEaDASS
# https://wiki.csh.rit.edu/wiki/S3
S3_ACCESS_ID=
S3_SECRET_KEY=
S3_BUCKET_NAME=
S3_HOST=s3.csh.rit.edu

# Postgres URI. Spin up your own for development,
# or make one on DEADASS (don't do this)
DB_URI=postgresql://plug:fancypantspassword@plug-postgres:5432/plug?sslmode=disable

# LDAP Creds. Consult the wiki page listed in the README.md
# https://wiki.csh.rit.edu/wiki/LDAP
LDAP_BIND_DN=
LDAP_BIND_PW=
LDAP_HOST=ldap.csh.rit.edu:636
LDAP_WRITE_MODE=false

# Gin-gonic settings. Base path should be set so it can find
# your resources.
GIN_MODE=release
BASE_PATH=./
